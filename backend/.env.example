DB_BACKEND=sqlite
# SQLITE_PATH=data/app.db

# Sign-in: signs the session cookie. Without it, everyone is signed out when the API
# restarts. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# SESSION_HTTPS_ONLY=true   # when served over HTTPS

# HANA (uv sync --extra hana)
# HANA_HOST=
# HANA_PORT=443
# HANA_USER=
# HANA_PASSWORD=
# HANA_SCHEMA=

# Assistant
OPENAI_API_KEY=
# The assistant plans multi-step queries with tools; larger models do this more
# reliably than mini ones. Check with `uv run python -m evals.charting`.
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=
